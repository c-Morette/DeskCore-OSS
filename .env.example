# Copie para .env e ajuste os valores. NUNCA versione o .env real.

# --- PostgreSQL ---
POSTGRES_DB=deskcore
POSTGRES_USER=deskcore_user
POSTGRES_PASSWORD=change_this_password

# --- Admin inicial (seedado no primeiro start da API) ---
# ⚠️ TROQUE a senha abaixo ANTES do primeiro start. O admin é criado uma única vez
#    (só se ainda não existir nenhum). Use uma senha forte e única.
SEED_ADMIN_EMAIL=admin@empresa.com.br
SEED_ADMIN_PASSWORD=ChangeMe@123456
SEED_ADMIN_FULLNAME=Administrador

# --- Ambiente ---
ASPNETCORE_ENVIRONMENT=Production

# --- Aplicação ---
APP_PUBLIC_URL=https://tickets.empresa.com.br
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES_PER_TICKET=5

# --- Auto-serviço do titular (cadastro + recuperação de senha) ---
# true (padrão) = clientes se auto-cadastram (confirmação por e-mail) e usam "Esqueci minha senha".
# false = modo privado/corporativo: /cadastro e recuperação de senha ficam desabilitados; só o Admin
#         cria contas e redefine senhas em /admin/usuarios (útil quando os e-mails são fictícios).
SelfService__Enabled=true

# --- Segurança ---
SECURITY_REQUIRE_HTTPS=true
SECURITY_ENABLE_RATE_LIMIT=true

# --- E-mail (SMTP) — auto-cadastro/confirmação. Configurado para Resend via SMTP. ---
# Sem Host/From definidos, o envio é desativado (NullEmailSender) e o cadastro fica só local.
Email__Smtp__Host=smtp.resend.com
Email__Smtp__Port=587
Email__Smtp__User=resend
Email__Smtp__Password=re_sua_api_key_do_resend
Email__Smtp__From=no-reply@seu-dominio.com
Email__Smtp__FromName=DeskCore
Email__Smtp__UseStartTls=true

# --- Anti-bot Cloudflare Turnstile (auto-cadastro). Sem SecretKey, a verificação é pulada. ---
Turnstile__SiteKey=0xSUA_SITE_KEY
Turnstile__SecretKey=0xSUA_SECRET_KEY
