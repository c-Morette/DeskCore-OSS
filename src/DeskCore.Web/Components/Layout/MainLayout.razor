@inherits LayoutComponentBase
@implements IDisposable
@using DeskCore.Domain.Constants
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<div class="dc-shell">
    <input type="checkbox" id="dc-nav-toggle" class="dc-nav-toggle" />

    <div class="dc-body">
        <aside class="dc-sidebar">
            <NavMenu />
        </aside>
        <label for="dc-nav-toggle" class="dc-scrim" aria-hidden="true"></label>

        <main class="dc-main">
            <header class="dc-topbar">
                <label for="dc-nav-toggle" class="dc-hamburger" aria-label="@Loc.T("Abrir menu", "Open menu")">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M2 4h12v1.5H2zM2 7.25h12v1.5H2zM2 10.5h12V12H2z"/></svg>
                </label>

                <div class="dc-breadcrumb">
                    DESKCORE <span class="dc-sep">//</span> <span class="dc-crumb">@SectionName</span>
                </div>

                <div class="dc-topbar-spacer"></div>

                <div class="dc-lang" title="Idioma / Language">
                    <a href="/language/pt-BR?returnUrl=@ReturnUrlParam" class="@(Loc.IsEnglish ? "" : "dc-lang-active")" data-enhance-nav="false">PT</a>
                    <span class="dc-lang-sep">/</span>
                    <a href="/language/en?returnUrl=@ReturnUrlParam" class="@(Loc.IsEnglish ? "dc-lang-active" : "")" data-enhance-nav="false">EN</a>
                </div>

                <AuthorizeView>
                    <Authorized>
                        <div class="dc-user">
                            <div class="dc-user-meta">
                                <div class="dc-user-name">@context.User.Identity?.Name</div>
                                <div class="dc-user-role">@RoleLabel(context)</div>
                            </div>
                            <div class="dc-avatar">@Initial(context)</div>
                            <a class="dc-icon-btn" href="minha-conta" title="@Loc.T("Minha conta", "My account")" aria-label="@Loc.T("Minha conta", "My account")">
                                <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/></svg>
                            </a>
                            <form method="post" action="account/logout" class="m-0" data-enhance="false">
                                <button type="submit" class="dc-icon-btn" title="@Loc.T("Sair", "Sign out")" aria-label="@Loc.T("Sair", "Sign out")">
                                    <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M6 12.5a.5.5 0 0 0 .5.5h6a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0-.5.5v2a.5.5 0 0 1-1 0v-2A1.5 1.5 0 0 1 6.5 2h6A1.5 1.5 0 0 1 14 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-6A1.5 1.5 0 0 1 5 12.5v-2a.5.5 0 0 1 1 0z"/><path d="M.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L1.707 7.5H10.5a.5.5 0 0 1 0 1H1.707l2.147 2.146a.5.5 0 0 1-.708.708z"/></svg>
                                </button>
                            </form>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-sm btn-outline-primary" href="login">@Loc.T("Entrar", "Sign in")</a>
                    </NotAuthorized>
                </AuthorizeView>
            </header>

            <article class="dc-content">
                @Body
            </article>
        </main>
    </div>

    <footer class="dc-statusbar">
        <span class="dc-status-seg">DESKCORE v@(Version)</span>
        <span class="dc-sep">//</span>
        <span class="dc-status-seg">@Loc.T("SISTEMA DE TICKETS", "TICKET SYSTEM")</span>
        <span class="dc-statusbar-right dc-online">STATUS: ONLINE</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro não tratado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly string Version =
        typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "1.0.0";

    private string SectionName = "PAINEL";

    // Caminho atual (local) para o seletor de idioma voltar à mesma página sem usar Referer.
    private string ReturnUrlParam => Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri));

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        SectionName = Section(Nav.ToBaseRelativePath(Nav.Uri));
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SectionName = Section(Nav.ToBaseRelativePath(e.Location));
        InvokeAsync(StateHasChanged);
    }

    private static string Section(string relativePath)
    {
        var path = relativePath.Split('?')[0].Trim('/');
        if (string.IsNullOrEmpty(path)) return Loc.T("PAINEL", "DASHBOARD");
        if (path.StartsWith("tickets/novo")) return Loc.T("NOVO TICKET", "NEW TICKET");
        if (path.StartsWith("tickets")) return "TICKETS";
        if (path.StartsWith("minha-conta")) return Loc.T("MINHA CONTA", "MY ACCOUNT");
        if (path.StartsWith("admin/categorias")) return Loc.T("CATEGORIAS", "CATEGORIES");
        if (path.StartsWith("admin/usuarios")) return Loc.T("USUÁRIOS", "USERS");
        if (path.StartsWith("login")) return "LOGIN";
        return path.ToUpperInvariant();
    }

    private static string RoleLabel(AuthenticationState ctx)
    {
        var u = ctx.User;
        if (u.IsInRole(Roles.Admin)) return Loc.T("Administrador", "Administrator");
        if (u.IsInRole(Roles.Agent)) return Loc.T("Atendente", "Agent");
        return Loc.T("Usuário", "User");
    }

    private static string Initial(AuthenticationState ctx)
    {
        var name = ctx.User.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
