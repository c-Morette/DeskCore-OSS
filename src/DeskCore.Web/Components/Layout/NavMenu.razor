@using DeskCore.Domain.Constants
@inject IWebHostEnvironment HostEnv
@inject DeskCoreApiClient Api
@inject NavigationManager Nav
@implements IDisposable

<div class="dc-nav">
    <div class="dc-brand">
        <span class="dc-brand-mark">◆</span>
        <span class="dc-brand-text">DESK<span class="dc-brand-accent">CORE</span></span>
    </div>

    <nav class="dc-nav-list">
        <AuthorizeView Roles="@AgentOrAdmin" Context="staff">
            <Authorized>
                <div class="dc-section-label">@Loc.T("Atendimento", "Support")</div>

                <NavLink class="dc-nav-link" href="tickets" Match="NavLinkMatch.All">
                    <svg class="dc-nav-ico" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 2.5a2.5 2.5 0 0 1 2.5-2.5h5A2.5 2.5 0 0 1 13 2.5v12a.5.5 0 0 1-.74.439L8 12.69l-4.26 2.249A.5.5 0 0 1 3 14.5zM5.5 1A1.5 1.5 0 0 0 4 2.5v11.171l3.76-1.985a.5.5 0 0 1 .48 0L12 13.671V2.5A1.5 1.5 0 0 0 10.5 1z"/></svg>
                    <span>Tickets</span>
                    @if (unseenCount > 0)
                    {
                        <span class="dc-nav-badge" title="@Loc.T($"{unseenCount} ticket(s) com novidade", $"{unseenCount} ticket(s) with updates")">@unseenCount</span>
                    }
                </NavLink>

                <NavLink class="dc-nav-link" href="tickets/novo">
                    <svg class="dc-nav-ico" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm6.5 4.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3a.5.5 0 0 1 1 0"/></svg>
                    <span>@Loc.T("Novo ticket", "New ticket")</span>
                </NavLink>

                <AuthorizeView Roles="@Roles.Admin" Context="admin">
                    <div class="dc-section-label dc-section-admin">@Loc.T("Administração", "Administration")</div>

                    <NavLink class="dc-nav-link" href="" Match="NavLinkMatch.All">
                        <svg class="dc-nav-ico" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5Z"/></svg>
                        <span>@Loc.T("Painel", "Dashboard")</span>
                    </NavLink>

                    <NavLink class="dc-nav-link" href="metricas">
                        <svg class="dc-nav-ico" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/></svg>
                        <span>@Loc.T("Métricas", "Metrics")</span>
                    </NavLink>

                    <NavLink class="dc-nav-link" href="admin/categorias">
                        <svg class="dc-nav-ico" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.825a2 2 0 0 1-1.991-1.819l-.637-7a2 2 0 0 1 .342-1.31L.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3m-8.322.12q.322-.119.687-.12h8.61l-.566-.566A1 1 0 0 0 9.172 2H2.5a1 1 0 0 0-1 .981z"/></svg>
                        <span>@Loc.T("Categorias", "Categories")</span>
                    </NavLink>

                    <NavLink class="dc-nav-link" href="admin/usuarios">
                        <svg class="dc-nav-ico" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/></svg>
                        <span>@Loc.T("Usuários", "Users")</span>
                    </NavLink>
                </AuthorizeView>
            </Authorized>

            <NotAuthorized>
                <div class="dc-section-label">@Loc.T("Meus Chamados", "My Requests")</div>

                <NavLink class="dc-nav-link" href="tickets" Match="NavLinkMatch.All">
                    <svg class="dc-nav-ico" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 2.5a2.5 2.5 0 0 1 2.5-2.5h5A2.5 2.5 0 0 1 13 2.5v12a.5.5 0 0 1-.74.439L8 12.69l-4.26 2.249A.5.5 0 0 1 3 14.5zM5.5 1A1.5 1.5 0 0 0 4 2.5v11.171l3.76-1.985a.5.5 0 0 1 .48 0L12 13.671V2.5A1.5 1.5 0 0 0 10.5 1z"/></svg>
                    <span>@Loc.T("Meus tickets", "My tickets")</span>
                    @if (unseenCount > 0)
                    {
                        <span class="dc-nav-badge" title="@Loc.T($"{unseenCount} ticket(s) com novidade", $"{unseenCount} ticket(s) with updates")">@unseenCount</span>
                    }
                </NavLink>

                <NavLink class="dc-nav-link" href="tickets/novo">
                    <svg class="dc-nav-ico" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm6.5 4.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3a.5.5 0 0 1 1 0"/></svg>
                    <span>@Loc.T("Novo ticket", "New ticket")</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <div class="dc-sysinfo">
        <div class="dc-section-label">@Loc.T("Sistema", "System")</div>
        <div class="dc-sysinfo-row"><span>@Loc.T("Versão", "Version")</span><span class="dc-sysinfo-val">@Version</span></div>
        <div class="dc-sysinfo-row"><span>@Loc.T("Ambiente", "Environment")</span><span class="dc-sysinfo-val">@HostEnv.EnvironmentName</span></div>
        <div class="dc-sysinfo-row"><span>Uptime</span><span class="dc-sysinfo-val">@Uptime</span></div>
        <div class="dc-copyright">© 2026 DeskCore</div>
    </div>
</div>

@code {
    private const string AgentOrAdmin = $"{Roles.Agent},{Roles.Admin}";

    private int unseenCount;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await RefreshUnseenAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => await RefreshUnseenAsync();

    private async Task RefreshUnseenAsync()
    {
        try { unseenCount = await Api.GetUnseenCountAsync(); }
        catch { unseenCount = 0; }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private static readonly string Version =
        typeof(NavMenu).Assembly.GetName().Version?.ToString(3) ?? "1.0.0";

    private static string Uptime
    {
        get
        {
            var span = DateTime.UtcNow - System.Diagnostics.Process.GetCurrentProcess().StartTime.ToUniversalTime();
            if (span < TimeSpan.Zero) span = TimeSpan.Zero;
            return $"{(int)span.TotalDays}d {span.Hours:D2}:{span.Minutes:D2}";
        }
    }
}
