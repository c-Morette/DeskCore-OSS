@page "/esqueci-senha"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using Microsoft.Extensions.Configuration
@inject IConfiguration Config

<PageTitle>@Loc.T("Esqueci minha senha", "Forgot password") — DeskCore</PageTitle>

<div class="card">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <div class="dc-login-brand"><span class="dc-login-mark">◆</span> DESK<span class="dc-login-accent">CORE</span></div>
            <div class="dc-login-sub">@Loc.T("Recuperação de acesso", "Account recovery")</div>
        </div>

        @if (!SelfServiceEnabled)
        {
            <div class="alert alert-warning py-2">
                @Loc.T("A recuperação de senha está desabilitada nesta instância. Solicite ao administrador.", "Password recovery is disabled on this instance. Please contact the administrator.")
            </div>
            <a class="btn btn-outline-secondary w-100" href="/login" data-enhance-nav="false">@Loc.T("Voltar ao login", "Back to sign in")</a>
        }
        else if (Sent)
        {
            <div class="alert alert-success py-2">
                @Loc.T("Se existir uma conta com este e-mail, enviamos um link para redefinir a senha. Verifique sua caixa de entrada (e o spam).", "If an account with this email exists, we've sent a link to reset your password. Check your inbox (and spam).")
            </div>
            <a class="btn btn-outline-secondary w-100" href="/login" data-enhance-nav="false">@Loc.T("Voltar ao login", "Back to sign in")</a>
        }
        else
        {
            @if (HasError)
            {
                <div class="alert alert-danger py-2">@Loc.T("Não foi possível processar a solicitação. Tente novamente.", "Could not process the request. Please try again.")</div>
            }

            <p class="dc-login-sub mb-3">@Loc.T("Informe seu e-mail e enviaremos um link para criar uma nova senha.", "Enter your email and we'll send you a link to set a new password.")</p>

            <form action="/account/forgot-password" method="post">
                <AntiforgeryToken />
                <div class="mb-3">
                    <label class="form-label">@Loc.T("E-mail", "Email")</label>
                    <input name="email" type="email" class="form-control" autocomplete="username" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">@Loc.T("Enviar link", "Send link")</button>
            </form>

            <div class="text-center mt-3 dc-login-sub">
                <a href="/login" data-enhance-nav="false">@Loc.T("Voltar ao login", "Back to sign in")</a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sent")] private string? SentFlag { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }

    private bool Sent => SentFlag == "1";
    private bool HasError => !string.IsNullOrEmpty(Error);
    private bool SelfServiceEnabled => Config.GetValue("SelfService:Enabled", true);
}
