@page "/tickets/{Id:long}"
@attribute [Authorize]
@using System.Security.Claims
@using DeskCore.Domain.Tickets
@inject DeskCoreApiClient Api
@inject NavigationManager Nav

<PageTitle>Ticket — DeskCore</PageTitle>

@if (loading)
{
    <p class="text-muted">@Loc.T("Carregando...", "Loading...")</p>
}
else if (ticket is null)
{
    <div class="alert alert-danger">@(error ?? Loc.T("Ticket não encontrado.", "Ticket not found."))</div>
    <a class="btn btn-link" href="/tickets">@Loc.T("Voltar", "Back")</a>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div class="flex-grow-1 me-3">
            @if (editing)
            {
                <div class="mb-2">
                    <label class="form-label small text-muted">@Loc.T("Título", "Title") <span class="dc-mono-gold">@ticket.Number</span></label>
                    <input class="form-control" @bind="editTitle" maxlength="200" placeholder="@Loc.T("Título do ticket", "Ticket title")" />
                </div>
            }
            else
            {
                <h1 class="dc-page-title h4 mb-2"><span class="dc-mono-gold">@ticket.Number</span> @ticket.Title</h1>
            }
            <div class="d-flex flex-wrap gap-2">
                <span class="@Labels.StatusBadge(ticket.Status)">@Labels.Status(ticket.Status)</span>
                <span class="@Labels.PriorityBadge(ticket.Priority)">@Labels.Priority(ticket.Priority)</span>
                <span class="dc-badge dc-badge--plain dc-badge--muted">@ticket.CategoryName</span>
            </div>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            @if (CanEdit && !editing)
            {
                <button class="btn btn-outline-primary btn-sm" @onclick="StartEdit" disabled="@busy">@Loc.T("Editar", "Edit")</button>
            }
            <a class="btn btn-outline-secondary btn-sm" href="/tickets">@Loc.T("Voltar", "Back")</a>
        </div>
    </div>

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@Loc.T("Descrição", "Description")</span>
                    @if (editing)
                    {
                        <span class="d-flex gap-2">
                            <button class="btn btn-success btn-sm" @onclick="SaveEditAsync" disabled="@busy">@Loc.T("Salvar", "Save")</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit" disabled="@busy">@Loc.T("Cancelar", "Cancel")</button>
                        </span>
                    }
                </div>
                <div class="card-body">
                    @if (editing)
                    {
                        <textarea class="form-control" rows="6" @bind="editDescription" maxlength="10000" placeholder="@Loc.T("Descreva o problema...", "Describe the problem...")"></textarea>
                    }
                    else
                    {
                        <p class="mb-0" style="white-space:pre-wrap">@ticket.Description</p>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">@Loc.T("Comentários", "Comments")</div>
                <div class="card-body">
                    @if (comments.Count == 0)
                    {
                        <p class="text-muted">@Loc.T("Nenhum comentário ainda.", "No comments yet.")</p>
                    }
                    else
                    {
                        @foreach (var c in comments)
                        {
                            <div class="dc-comment @(c.IsInternal ? "dc-comment--internal" : "")">
                                <div class="small text-muted">
                                    @(c.UserName ?? Loc.T("Usuário", "User")) • @c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    @if (c.IsInternal)
                                    {
                                        <span class="dc-badge dc-badge--gold ms-1">@Loc.T("Interno", "Internal")</span>
                                    }
                                </div>
                                <div style="white-space:pre-wrap">@c.Message</div>
                            </div>
                        }
                    }

                    <div class="mt-3">
                        <textarea class="form-control mb-2" rows="3" placeholder="@Loc.T("Escreva um comentário...", "Write a comment...")" @bind="newComment"></textarea>
                        <div class="d-flex justify-content-between align-items-center">
                            @if (isAgentOrAdmin)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="internal" @bind="newCommentInternal" />
                                    <label class="form-check-label" for="internal">@Loc.T("Comentário interno", "Internal comment")</label>
                                </div>
                            }
                            else
                            {
                                <span></span>
                            }
                            <button class="btn btn-primary btn-sm" @onclick="AddCommentAsync" disabled="@busy">@Loc.T("Enviar", "Send")</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">@Loc.T("Anexos", "Attachments")</div>
                <div class="card-body">
                    @if (attachments.Count == 0)
                    {
                        <p class="text-muted">@Loc.T("Nenhum anexo.", "No attachments.")</p>
                    }
                    else
                    {
                        <ul class="list-group mb-3">
                            @foreach (var a in attachments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <a href="@($"/files/{ticket.Id}/{a.Id}")" target="_blank">@a.OriginalFileName</a>
                                    <span>
                                        <small class="text-muted me-2">@FormatSize(a.FileSize)</small>
                                        @if (isAgentOrAdmin || a.UploadedByUserId == currentUserId)
                                        {
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAttachmentAsync(a.Id)" disabled="@busy">@Loc.T("Remover", "Remove")</button>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    @if (uploadError is not null)
                    {
                        <div class="alert alert-danger py-2 mb-2">@uploadError</div>
                    }
                    @if (uploadSuccess is not null)
                    {
                        <div class="alert alert-success py-2 mb-2">@uploadSuccess</div>
                    }

                    <label class="dc-filepicker @(uploading ? "disabled" : "")">
                        <span class="dc-filepicker-btn">@Loc.T("Escolher arquivo", "Choose file")</span>
                        <span class="dc-filepicker-name">@(selectedFile is null ? Loc.T("Nenhum arquivo escolhido", "No file chosen") : selectedFile.Name)</span>
                        <InputFile OnChange="OnFileSelected" class="dc-file-input" disabled="@uploading" />
                    </label>
                    <div class="form-text mb-2">@Loc.T("Até 10 MB. Tipos: png, jpg, jpeg, pdf, txt, log.", "Up to 10 MB. Types: png, jpg, jpeg, pdf, txt, log.")</div>

                    @if (selectedFile is not null && !uploading)
                    {
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <small class="text-muted">@Loc.T("Selecionado:", "Selected:") <strong>@selectedFile.Name</strong> (@FormatSize(selectedFile.Size))</small>
                            <span class="d-flex gap-2">
                                <button class="btn btn-primary btn-sm" @onclick="UploadSelectedAsync">@Loc.T("Enviar anexo", "Upload attachment")</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSelection">@Loc.T("Cancelar", "Cancel")</button>
                            </span>
                        </div>
                    }

                    @if (uploading)
                    {
                        <div class="small text-muted mb-1">@Loc.T("Enviando", "Uploading") @selectedFile?.Name... @uploadProgress%</div>
                        <div class="progress" role="progressbar" aria-valuenow="@uploadProgress" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width:@(uploadProgress)%"></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header">@Loc.T("Informações", "Information")</div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><small class="text-muted">@Loc.T("Aberto por", "Opened by")</small><br />@(ticket.CreatedByName ?? "—")</li>
                    <li class="list-group-item"><small class="text-muted">@Loc.T("Responsável", "Assignee")</small><br />@(ticket.AssignedToName ?? "—")</li>
                    <li class="list-group-item"><small class="text-muted">@Loc.T("Criado em", "Created")</small><br />@ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</li>
                    @if (ticket.ResolvedAt is not null)
                    {
                        <li class="list-group-item"><small class="text-muted">@Loc.T("Resolvido em", "Resolved")</small><br />@ticket.ResolvedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</li>
                    }
                </ul>
            </div>

            <div class="card mb-3">
                <div class="card-header">@Loc.T("Ações", "Actions")</div>
                <div class="card-body d-grid gap-2">
                    @if (isAgentOrAdmin)
                    {
                        <button class="btn btn-outline-primary btn-sm" @onclick="AssignToMeAsync" disabled="@busy">@Loc.T("Assumir ticket", "Assign to me")</button>

                        <div class="input-group input-group-sm">
                            <select class="form-select" @bind="selectedStatus">
                                @foreach (var s in Enum.GetValues<TicketStatus>())
                                {
                                    <option value="@s">@Labels.Status(s)</option>
                                }
                            </select>
                            <button class="btn btn-outline-secondary" @onclick="ChangeStatusAsync" disabled="@busy">@Loc.T("Aplicar status", "Apply status")</button>
                        </div>

                        <div class="input-group input-group-sm">
                            <select class="form-select" @bind="selectedPriority">
                                @foreach (var p in Enum.GetValues<TicketPriority>())
                                {
                                    <option value="@p">@Labels.Priority(p)</option>
                                }
                            </select>
                            <button class="btn btn-outline-secondary" @onclick="ChangePriorityAsync" disabled="@busy">@Loc.T("Aplicar prioridade", "Apply priority")</button>
                        </div>

                        <button class="btn btn-outline-danger btn-sm" @onclick="CancelAsync" disabled="@busy">@Loc.T("Cancelar ticket", "Cancel ticket")</button>
                    }
                    <button class="btn btn-success btn-sm" @onclick="CloseAsync" disabled="@busy">@Loc.T("Fechar ticket", "Close ticket")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private TicketResponse? ticket;
    private IReadOnlyList<CommentResponse> comments = [];
    private IReadOnlyList<AttachmentResponse> attachments = [];
    private bool loading = true;
    private bool busy;
    private string? error;

    private bool isAgentOrAdmin;
    private string? currentUserId;

    private string newComment = "";
    private bool newCommentInternal;
    private TicketStatus selectedStatus;
    private TicketPriority selectedPriority;

    // Edição de título/descrição
    private bool editing;
    private string editTitle = "";
    private string editDescription = "";
    private bool CanEdit => ticket is not null && !TicketStateMachine.IsTerminal(ticket.Status);

    // Upload de anexos (seleção explícita + progresso + feedback)
    private IBrowserFile? selectedFile;
    private bool uploading;
    private int uploadProgress;
    private string? uploadError;
    private string? uploadSuccess;
    private const long MaxUploadBytes = 10 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            isAgentOrAdmin = user.IsInRole(Roles.Agent) || user.IsInRole(Roles.Admin);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            ticket = await Api.GetTicketAsync(Id);
            selectedStatus = ticket.Status;
            selectedPriority = ticket.Priority;
            comments = await Api.ListCommentsAsync(Id);
            attachments = await Api.ListAttachmentsAsync(Id);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            ticket = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Run(Func<Task> action)
    {
        busy = true;
        error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(newComment)) return Task.CompletedTask;
        return Run(async () =>
        {
            await Api.AddCommentAsync(Id, new CreateCommentRequest { Message = newComment, IsInternal = newCommentInternal });
            newComment = "";
            newCommentInternal = false;
        });
    }

    private Task AssignToMeAsync() =>
        currentUserId is null ? Task.CompletedTask : Run(() => Api.AssignTicketAsync(Id, currentUserId));

    private Task ChangeStatusAsync() => Run(() => Api.ChangeStatusAsync(Id, selectedStatus));
    private Task ChangePriorityAsync() => Run(() => Api.ChangePriorityAsync(Id, selectedPriority));
    private Task CloseAsync() => Run(() => Api.CloseTicketAsync(Id));
    private Task CancelAsync() => Run(() => Api.CancelTicketAsync(Id));
    private Task DeleteAttachmentAsync(long attachmentId) => Run(() => Api.DeleteAttachmentAsync(Id, attachmentId));

    private void StartEdit()
    {
        if (ticket is null) return;
        editTitle = ticket.Title;
        editDescription = ticket.Description;
        editing = true;
        error = null;
    }

    private void CancelEdit()
    {
        editing = false;
        error = null;
    }

    private Task SaveEditAsync()
    {
        if (string.IsNullOrWhiteSpace(editTitle) || string.IsNullOrWhiteSpace(editDescription))
        {
            error = Loc.T("Título e descrição são obrigatórios.", "Title and description are required.");
            return Task.CompletedTask;
        }
        return Run(async () =>
        {
            await Api.UpdateTicketAsync(Id, new UpdateTicketRequest { Title = editTitle.Trim(), Description = editDescription.Trim() });
            editing = false;
        });
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadError = null;
        uploadSuccess = null;
        uploadProgress = 0;
    }

    private void ClearSelection()
    {
        selectedFile = null;
        uploadError = null;
    }

    private async Task UploadSelectedAsync()
    {
        if (selectedFile is null) return;
        var file = selectedFile;

        uploading = true;
        uploadError = null;
        uploadSuccess = null;
        uploadProgress = 0;

        try
        {
            if (file.Size > MaxUploadBytes)
            {
                uploadError = Loc.T("Arquivo excede o limite de 10 MB.", "File exceeds the 10 MB limit.");
                return;
            }

            // Lê o arquivo do navegador em blocos, reportando o progresso real
            // (esta etapa, via SignalR, é a mais lenta para arquivos grandes).
            using var ms = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: MaxUploadBytes))
            {
                var buffer = new byte[64 * 1024];
                long readTotal = 0;
                int read;
                while ((read = await stream.ReadAsync(buffer)) > 0)
                {
                    await ms.WriteAsync(buffer.AsMemory(0, read));
                    readTotal += read;
                    var pct = file.Size == 0 ? 100 : (int)(readTotal * 100 / file.Size);
                    if (pct != uploadProgress)
                    {
                        uploadProgress = pct;
                        StateHasChanged();
                    }
                }
            }
            ms.Position = 0;

            uploadProgress = 100;
            StateHasChanged();

            await Api.UploadAttachmentAsync(Id, ms, file.Name,
                string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType);

            uploadSuccess = Loc.T($"\"{file.Name}\" enviado com sucesso.", $"\"{file.Name}\" uploaded successfully.");
            selectedFile = null;
            attachments = await Api.ListAttachmentsAsync(Id);
        }
        catch (ApiException ex)
        {
            uploadError = ex.Message;
        }
        catch (Exception ex)
        {
            uploadError = Loc.T("Falha ao enviar o anexo: ", "Failed to upload the attachment: ") + ex.Message;
        }
        finally
        {
            uploading = false;
            StateHasChanged();
        }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = ["B", "KB", "MB"];
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1) { size /= 1024; unit++; }
        return $"{size:0.#} {units[unit]}";
    }
}
